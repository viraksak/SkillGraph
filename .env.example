# SkillGraph Environment Configuration Template (Zero Real Secrets)
# Copy this file to `.env` locally and set credentials before PostgreSQL migration.

SKILLGRAPH_DB_HOST=127.0.0.1
SKILLGRAPH_DB_PORT=5432
SKILLGRAPH_DB_NAME=skillgraph
SKILLGRAPH_DB_USER=postgres
SKILLGRAPH_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Offline relational fallback used when PostgreSQL credentials or driver are unavailable
SKILLGRAPH_SQLITE_PATH=:memory:

# API service runtime
SKILLGRAPH_API_HOST=127.0.0.1
SKILLGRAPH_API_PORT=8000
SKILLGRAPH_ENVIRONMENT=development

